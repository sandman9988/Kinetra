# MetaAPI Cloud Configuration (DEFAULT - Recommended)
# Copy this file to .env and fill in your credentials
#
# MetaAPI is the DEFAULT connection method:
# - Works from Linux/Mac/Windows/WSL2
# - No local MT5 terminal required
# - Cloud-based, always available
#
# Setup:
# 1. Create account at https://app.metaapi.cloud/
# 2. Add your MT5 broker credentials
# 3. Get your API token and account ID
# 4. Fill in values below

# MetaAPI Token (get from https://app.metaapi.cloud/token)
METAAPI_TOKEN=your_token_here

# MetaAPI Account ID (UUID format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
METAAPI_ACCOUNT_ID=your_account_id_here

# Account region (usually determined automatically)
# METAAPI_REGION=

# ============================================================================
# FALLBACK OPTIONS (Optional - only if MetaAPI is unavailable)
# ============================================================================

# MT5 Bridge Server (for WSL2 -> Windows socket connection)
# MT5_BRIDGE_HOST=localhost
# MT5_BRIDGE_PORT=5555

# Offline Mode Config (path to cached symbol specs)
# SYMBOL_SPECS_PATH=config/symbols.json

# ============================================================================
# DNS HARDENING / RESOLVER FAILOVER (Optional)
# ============================================================================
# App-level DNS resolver pool (no system-level DNS change required).
# Used by Kinetra endpoint selection/hardening.
# KINETRA_DNS_RESOLVERS=1.1.1.1,1.0.0.1,8.8.8.8,8.8.4.4,9.9.9.9,149.112.112.112
# KINETRA_DNS_QUERY_TIMEOUT_S=2.0
# KINETRA_DNS_QUERY_LIFETIME_S=4.0
# KINETRA_DNS_ALLOW_SUFFIXES=ctraderapi.com,spotware.com
# KINETRA_DNS_FAIL_CLOSED=true
